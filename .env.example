# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Authentication (NextAuth)
# You can generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
AUTH_GOOGLE_ID="your_google_client_id"
AUTH_GOOGLE_SECRET="your_google_client_secret"
AUTH_MICROSOFT_ENTRA_ID_ID="your_microsoft_client_id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your_microsoft_client_secret"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="your_microsoft_issuer_url"

# Email / Notifications (Resend)
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="onboarding@resend.dev"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Configuration
ADMIN_EMAILS="admin1@example.com,admin2@example.com"
